# URL del portal PJe a scrapear (por defecto TRF5)
TARGET_URL=https://pjett.trf5.jus.br/pjeconsulta/ConsultaPublica/listView.seam

# Directorios de salida
OUTPUT_DIR=./output
DOWNLOAD_DIR=./output/downloads

# Configuración de resiliencia y rate-limiting
MAX_RETRIES=4
BASE_DELAY_MS=1000
MAX_DELAY_MS=15000
REQUEST_DELAY_MS=800

# Concurrencia de descargas de documentos (1 para evitar saturar el WAF)
CONCURRENCY=1
